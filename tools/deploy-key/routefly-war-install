#!/bin/bash
# root 로 도는 부분(sudoers 로 deploy 계정에 이 파일 하나만 허용). routefly-deploy 가 부릅니다.
set -euo pipefail
umask 022
cd /   # 2026-11-02 홍TV님 점검: 부른 곳(deploy 홈 등)의 파일을 python 이 읽지 않게 - 아래 python3 -I 와 함께
WEBAPPS=/opt/tomcat/webapps
WAR=$WEBAPPS/routefly.war
KEEP=/var/backups/routefly-war
LOG=/var/log/routefly-deploy.log
MIN=1000000; MAX=104857600
# 배치(2026-11-04): jar 는 /app/routefly/batch/deploy/lib/routefly-batch.jar(root:routefly 640 - docs/deploy-lightsail.md 9-2 · 9-4 와 같게)
BHOME=/app/routefly/batch
BLIB=$BHOME/deploy/lib
JAR_KEEP=$KEEP/routefly-batch.jar.prev
JMIN=10000; JMAX=52428800
# 쿼리 XML(2026-11-12): deploy/conf/sql/<영역>/<이름>.xml(root:routefly 640), 앞 것은 $KEEP/batch-sql/<영역>.<이름>.prev(root 600)
BSQL=$BHOME/deploy/conf/sql
SQL_KEEP=$KEEP/batch-sql
SMAX=2097152
BATCH='^(courseImport|forestTrail|durunubi|osmBike|osmHike|komount|knpsTrail|knpsSign|knpsSpot)$'
mkdir -p "$KEEP"; chmod 700 "$KEEP"
log() { echo "$(date '+%F %T') $*" >> "$LOG"; echo "$*"; }
# 2026-11-03 홍TV님 보안 점검: webapps 는 tomcat 계정 폴더라 routefly.war · 임시 파일을 바로 가기 링크로 바꿔 둘 수 있음 -
# root 가 그 링크를 따라 다른 파일을 베끼거나 덮지 않게, 링크면 거절하고 파일은 링크를 따라가지 않고(O_NOFOLLOW) 새로(O_EXCL) 만든 뒤 이름만 바꿈.
info() { [ -f "$1" ] && [ ! -L "$1" ] && echo "$(stat -c %s "$1")B $(date -r "$1" '+%F %T') $(sha256sum < "$1" | cut -c1-12)" || echo "없음"; }
nolink() { [ ! -L "$1" ] || { log "거절: $1 이 바로 가기 링크임"; exit 3; }; }
# copy <원본> <폴더> <이름> <주인> <권한>: 원본을 링크를 따라가지 않고 열어(보통 파일만) 폴더 안 새 임시 파일(O_EXCL · O_NOFOLLOW)에 쓰고
# 주인 · 권한 · fsync 뒤 같은 폴더에서 이름만 바꿈(rename 은 그 자리가 링크여도 따라가지 않고 바꿈). 톰캣이 반쯤 쓴 war 를 읽지 않게.
copy() {
  python3 -I - "$@" <<'PY'
import os, pwd, secrets, stat, sys
src, folder, name, owner, mode = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], int(sys.argv[5], 8)
fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
if not stat.S_ISREG(os.fstat(fd).st_mode):
    sys.exit(1)
d = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
tmp = "." + name + ".new-" + secrets.token_hex(6)
out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=d)
try:
    with os.fdopen(fd, "rb") as f, os.fdopen(out, "wb", closefd=False) as o:
        while True:
            b = f.read(1 << 20)
            if not b:
                break
            o.write(b)
    u = pwd.getpwnam(owner)
    os.fchown(out, u.pw_uid, u.pw_gid)
    os.fchmod(out, mode)
    os.fsync(out)
    os.close(out)
    os.rename(tmp, name, src_dir_fd=d, dst_dir_fd=d)
    os.fsync(d)
except BaseException:
    try:
        os.unlink(tmp, dir_fd=d)
    except OSError:
        pass
    raise
PY
}
# jcopy <원본 경로> <대상 폴더> <이름> <주인> <무리> <권한>: copy 와 같되 원본 · 대상 폴더를 / 부터 한 칸씩 링크를 따라가지 않고 엶.
# /app/routefly/batch 아래는 routefly 계정 것이라(배치가 뚫리면) 폴더를 바로 가기 링크로 바꿔 둘 수 있음 - root 가 다른 곳에 쓰거나 읽지 않게.
jcopy() {
  python3 -I - "$@" <<'PY'
import grp, os, pwd, secrets, stat, sys
src, folder, name, owner, group, mode = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5], int(sys.argv[6], 8)
def walk(path):
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    for part in [p for p in path.split("/") if p]:
        nfd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
        os.close(fd)
        fd = nfd
    return fd
sd = walk(os.path.dirname(src))
fd = os.open(os.path.basename(src), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=sd)
if not stat.S_ISREG(os.fstat(fd).st_mode):
    sys.exit(1)
d = walk(folder)
tmp = "." + name + ".new-" + secrets.token_hex(6)
out = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=d)
try:
    with os.fdopen(fd, "rb") as f, os.fdopen(out, "wb", closefd=False) as o:
        while True:
            b = f.read(1 << 20)
            if not b:
                break
            o.write(b)
    os.fchown(out, pwd.getpwnam(owner).pw_uid, grp.getgrnam(group).gr_gid)
    os.fchmod(out, mode)
    os.fsync(out)
    os.close(out)
    os.rename(tmp, name, src_dir_fd=d, dst_dir_fd=d)
    os.fsync(d)
except BaseException:
    try:
        os.unlink(tmp, dir_fd=d)
    except OSError:
        pass
    raise
PY
}
# routefly-batch jar 인가(zip · RouteflyBatch.class) - 링크를 따라가지 않고 / 부터 한 칸씩
jcheck() {
  python3 -I - "$1" <<'PY'
import os, sys, zipfile
try:
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    parts = [p for p in sys.argv[1].split("/") if p]
    for part in parts[:-1]:
        nfd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
        os.close(fd)
        fd = nfd
    ffd = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW, dir_fd=fd)
    with os.fdopen(ffd, "rb") as f:
        z = zipfile.ZipFile(f)
        ok = z.testzip() is None and "com/gh/routefly/batch/RouteflyBatch.class" in z.namelist()
except Exception:
    ok = False
sys.exit(0 if ok else 1)
PY
}
# 배치를 손으로 돌리는 systemd 단위 이름(배치마다 하나) - 도는 중인지 볼 때도 씀
unit() { echo "routefly-once-$1"; }
anyrun() {   # 정기 회차나 손 실행이 도는가
  systemctl is-active --quiet routefly-batch.service && return 0
  systemctl list-units --type=service --state=active --no-legend 'routefly-once-*' 2>/dev/null | grep -q . && return 0
  return 1
}
