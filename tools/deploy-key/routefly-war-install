#!/bin/bash
# root 로 도는 부분(sudoers 로 deploy 계정에 이 파일 하나만 허용). routefly-deploy 가 부릅니다.
set -euo pipefail
umask 022
cd /   # 2026-11-02 홍TV님 점검: 부른 곳(deploy 홈 등)의 파일을 python 이 읽지 않게 - 아래 python3 -I 와 함께
WAR=/opt/tomcat/webapps/routefly.war
KEEP=/var/backups/routefly-war
LOG=/var/log/routefly-deploy.log
MIN=1000000; MAX=104857600
mkdir -p "$KEEP"; chmod 700 "$KEEP"
log() { echo "$(date '+%F %T') $*" >> "$LOG"; echo "$*"; }
info() { [ -f "$1" ] && echo "$(stat -c %s "$1")B $(date -r "$1" '+%F %T') $(sha256sum "$1" | cut -c1-12)" || echo "없음"; }
put() {   # 같은 폴더의 숨김 임시 파일에 쓴 뒤 mv - 톰캣이 반쯤 쓴 war 를 읽지 않게
  install -o tomcat -g tomcat -m 644 "$1" "/opt/tomcat/webapps/.routefly.war.new"
  mv -f /opt/tomcat/webapps/.routefly.war.new "$WAR"
}
case "${1:-}" in
  deploy)
    src="${2:-}"
    [[ "$src" =~ ^/tmp/rfwar\.[A-Za-z0-9]{8}$ ]] || { log "거절: 받은 파일 경로가 이상함"; exit 3; }
    # 2026-11-02 홍TV님 점검(검사한 때와 쓰는 때 사이 바꿔치기): deploy 계정의 파일은 처음에 한 번만 열어(바로 가기 링크면 열지 않음)
    # root 만 닿는 임시 폴더로 베끼고, 그 뒤 검사 · 설치는 베낀 것만 씁니다.
    work=$(mktemp -d /var/tmp/rfwar-in.XXXXXXXX)
    trap 'rm -rf "$work"' EXIT
    copy="$work/routefly.war"
    python3 -I - "$src" "$copy" "$MAX" <<'PY' || { log "거절: 받은 파일이 이상함(링크 · 보통 파일 아님 · deploy 것이 아님 · 너무 큼)"; exit 3; }
import os, pwd, stat, sys
src, dst, mx = sys.argv[1], sys.argv[2], int(sys.argv[3])
fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
st = os.fstat(fd)
if not stat.S_ISREG(st.st_mode) or st.st_uid != pwd.getpwnam("deploy").pw_uid or st.st_nlink != 1:
    sys.exit(1)
n = 0
with os.fdopen(fd, "rb") as f, open(dst, "xb") as o:
    while True:
        b = f.read(1 << 20)
        if not b:
            break
        n += len(b)
        if n > mx:
            sys.exit(1)
        o.write(b)
PY
    size=$(stat -c %s "$copy")
    [ "$size" -ge "$MIN" ] && [ "$size" -le "$MAX" ] || { log "거절: 크기 ${size}B (1MB ~ 100MB 만)"; exit 3; }
    python3 -I - "$copy" <<'PY' || { log "거절: routefly war 가 아님(zip 이 아니거나 RouteflyConfig.class 없음)"; exit 3; }
import sys, zipfile
z = zipfile.ZipFile(sys.argv[1])
if z.testzip() is not None or "WEB-INF/classes/com/gh/routefly/web/RouteflyConfig.class" not in z.namelist():
    sys.exit(1)
PY
    [ -f "$WAR" ] && cp -p "$WAR" "$KEEP/routefly.war.prev"
    put "$copy"
    log "배포 $(info "$WAR") (앞 것은 $KEEP/routefly.war.prev)"
    ;;
  rollback)
    [ -f "$KEEP/routefly.war.prev" ] || { log "되돌리기 실패: 앞 war 없음"; exit 3; }
    cp -p "$WAR" "$KEEP/routefly.war.rolledback" 2>/dev/null || true
    put "$KEEP/routefly.war.prev"
    log "되돌림 $(info "$WAR")"
    ;;
  status)
    echo "지금 war: $(info "$WAR")"
    echo "앞 war:   $(info "$KEEP/routefly.war.prev")"
    echo "최근 기록:"; tail -5 "$LOG" 2>/dev/null || echo "(없음)"
    ;;
  *) exit 2 ;;
esac
