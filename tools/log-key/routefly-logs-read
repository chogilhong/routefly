#!/bin/bash
# tomcat 계정으로 도는 읽기 부분(sudoers 로 logview 계정에 이 파일 하나만 허용, 2026-10-28 부터 root 아님). /opt/tomcat/logs 아래 파일만, 읽기만 합니다.
#   files            - 로그 파일 목록(크기 · 시각, 한국 시간)
#   tail [N]         - catalina.out 끝 N줄(기본 200, 많아야 3000)
#   log 이름 [N]     - 그 로그 파일 끝 N줄(이름은 .log · .out · .txt, 폴더 · 경로 없이). 산악회 기록(party*) · 원본 접속 기록(localhost_access_log*)은 안 됨
#                      (2026-11-07 전체 점검: 방 코드 · 회사 코드 · 원래 IP 가 그대로 보였음 - 접속 기록은 아래 access 요약으로)
#   grep 낱말 [N]    - catalina.out 끝 5만 줄에서 그 낱말(글자 그대로)이 든 줄 중 마지막 N줄
#   access 날짜 [부터 까지] - 그 날(YYYY-MM-DD) 톰캣 접속 기록 요약(2026-10-28): 화면 수 · 경로 묶음 · 15분 · 브라우저 종류 · 많이 연 곳 상위 10.
#                      2026-11-08: 넘김(3xx) · 오류(4xx · 5xx) 응답도 경로 묶음 · 상태별 수와 그중 검색 로봇 · 구글봇 수(주소 · 코스 번호 없이 - 없어진 코스 주소 301 확인용)
#                      부터 · 까지(HH:MM, 까지는 빼고)를 주면 그 시각만(2026-11-06 PC: 날마다 같은 시각끼리 견주려는데 log 이름 N 은 끝 3000줄까지라 앞 시각을 못 봄).
#                      종류마다 곳 수 · 그중 화면 js 가 돈 곳(/api/seen 을 낸 곳), js 를 안 낸 사람 쪽 곳의 브라우저 글 상위 10(곳 수)도.
#                      주소는 내보내지 않음 - 이번 한 번만 쓰는 무작위 값과 섞은 해시 8글자(다시 돌리면 달라져 이어 볼 수 없음)
# 한 줄은 400자까지 자르고, 화면을 어지럽히는 제어 글자(색 바꾸기 등)는 지웁니다(2026-10-28 점검 - 접속 기록의 브라우저 글은 남이 넣는 글).
set -euo pipefail
DIR=/opt/tomcat/logs
MAXN=3000
# 산악회 방 코드 · 회사(사무실) 코드는 가림 - room=… · code=… (2026-11-07 전체 점검: routefly.log · catalina.out 에 그대로 남아 이 열쇠로 보였음)
mask() { sed -E 's/((room|code|office|join)=)[A-Za-z0-9_-]{4,}/\1******/g'; }
num() { if [[ "${1:-}" =~ ^[0-9]{1,4}$ ]] && [ "$1" -ge 1 ] && [ "$1" -le "$MAXN" ]; then echo "$1"; else echo 200; fi; }
okfile() {
  local re='^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\.(log|out|txt)$'
  # 바로 가기(링크)로 폴더 밖 파일을 읽지 못하게 [ ! -L ] 도 봄
  [[ "${1:-}" =~ $re ]] && [ -f "$DIR/$1" ] && [ ! -L "$DIR/$1" ] || { echo "파일 이름이 이상하거나 없습니다(files 로 목록을 보세요)."; exit 3; }
}
case "${1:-}" in
  files) ls -l --time-style=+%F_%T "$DIR" | awk 'NR>1 {print $5, $6, $7}' ;;
  tail)  okfile catalina.out; n=$(num "${2:-}"); tail -n "$n" "$DIR/catalina.out" | cut -c1-400 | tr -d '\000-\010\013-\037\177' | mask ;;
  log)
    okfile "${2:-}"
    case "$2" in party*|localhost_access_log*) echo "그 파일은 이 열쇠로 그대로 보지 않습니다(방 코드 · IP). 접속 기록은 access 날짜 [부터 까지] 요약으로."; exit 3 ;; esac
    n=$(num "${3:-}"); tail -n "$n" "$DIR/$2" | cut -c1-400 | tr -d '\000-\010\013-\037\177' | mask ;;
  grep)
    re='^[][A-Za-z0-9_.:=-]{2,60}$'
    [[ "${2:-}" =~ $re ]] || { echo "낱말은 영문 · 숫자 · [ ] _ . : = - 로 2~60자"; exit 3; }
    okfile catalina.out   # 바로 가기면 거절(2026-10-30 점검)
    n=$(num "${3:-}")
    hits=$(tail -n 50000 "$DIR/catalina.out" | grep -aF -- "$2" || true)
    total=$(printf '%s' "$hits" | grep -c '' || true)
    # 맞은 줄이 보이는 줄보다 많으면 먼저 알림(2026-11-02 PC: 끝 200줄만 보여 "없다" 로 착각했음)
    if [ "$total" -gt "$n" ]; then echo "# 맞은 줄 ${total}개 - 마지막 ${n}줄만 보임(낱말을 더 좁히거나 N 을 늘리세요)"; else echo "# 맞은 줄 ${total}개"; fi
    [ "$total" -gt 0 ] && printf '%s\n' "$hits" | tail -n "$n" | cut -c1-400 | tr -d '\000-\010\013-\037\177' | mask || true
    ;;
  access)
    [[ "${2:-}" =~ ^20[0-9]{2}-[01][0-9]-[0-3][0-9]$ ]] || { echo "날짜는 YYYY-MM-DD"; exit 3; }
    from="${3:-00:00}"; to="${4:-24:00}"
    [[ "$from" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] && [[ "$to" =~ ^(([01][0-9]|2[0-3]):[0-5][0-9]|24:00)$ ]] || { echo "시각은 HH:MM (예: access 2026-11-06 02:00 11:00)"; exit 3; }
    f="$DIR/localhost_access_log.$2.txt"
    [ -f "$f" ] && [ ! -L "$f" ] || { echo "그 날 접속 기록이 없습니다."; exit 3; }
    python3 -I - "$f" "$from" "$to" <<'PY'
import sys, re, os, hashlib, collections
salt = os.urandom(16)
T0, T1 = sys.argv[2], sys.argv[3]
# 맨 앞 칸은 X-Forwarded-For - 손님이 보낸 값 뒤에 nginx 가 실제 주소를 붙임("가짜, 실제") → 맨 뒤 값만(2026-10-28 보안 점검)
LINE = re.compile(r'^(.+?) \[[^:]+:(\d\d):(\d\d):\d\d [^\]]*\] "(\S+) (\S+)" (\d{3}) \S+(?: "(.*)")?$')
def page(p):
    if p.startswith("/routefly/api/") or re.search(r"\.(js|css|png|jpg|jpeg|svg|ico|json|webmanifest|txt|xml|woff2?|map|gpx|pbf)$", p): return None
    for pre, k in (("/routefly/en/m/", "/en/m/"), ("/routefly/m/", "/m/"), ("/routefly/c/", "/c/"), ("/routefly/s/", "/s/")):
        if p.startswith(pre): return k
    if p in ("/routefly/", "/routefly"): return "/"
    m = re.match(r"^/routefly/([a-z0-9-]{1,40}\.html)$", p)   # 이름 꼴만 - "hike.html;아무글.html" 같은 남이 만든 글이 요약에 나오지 않게
    return m.group(1) if m else None
def kind(ua):
    if not ua or ua == "-": return "UA 없음(예전 줄 · 서버 안)"
    u = ua.lower()
    if "routefly-check" in u: return "운영자 확인"   # PC Claude 배포 확인(2026-10-31 - 앱 통계에서도 뺌, StatsFilter.selfCheck)
    if re.search(r"googlebot|mediapartners-google|yeti|daum|bingbot|duckduckbot|applebot|naver", u): return "검색 로봇"   # mediapartners-google - 애드센스(2026-11-06, 앱 통계 Stats.UA_SEARCH 와 같게)
    if re.search(r"gptbot|chatgpt|claudebot|claude-web|perplexity|ccbot|bytespider|amazonbot|meta-externalagent|ai2bot", u): return "AI 수집"
    if re.search(r"bot|crawl|spider|slurp|scan|fetch|monitor|preview", u): return "그 밖의 로봇"
    if re.search(r"python|curl|wget|go-http|java/|okhttp|axios|node-fetch|libwww|httpclient|postman", u): return "프로그램"
    if "headless" in u: return "Headless 브라우저"
    m = re.search(r"chrome/(\d+)", u)
    if m and int(m.group(1)) < 130 and "samsungbrowser" not in u and "whale" not in u: return "오래된 크롬(<130)"
    return "사람 브라우저"
tot = 0; paths = collections.Counter(); q = collections.Counter(); kinds = collections.Counter(); who = collections.Counter(); whoKind = {}; whoPath = collections.defaultdict(collections.Counter); qk = collections.defaultdict(collections.Counter)
seen = set(); whoUa = {}; errs = collections.Counter(); errBot = collections.Counter(); errG = collections.Counter()
def safe(t): return re.sub(r"[\x00-\x1f\x7f]", "", t or "-")[:160]
with open(sys.argv[1], encoding="utf-8", errors="replace") as fh:
    for line in fh:
        m = LINE.match(line.rstrip("\n"))
        if not m: continue
        hm = m.group(2) + ":" + m.group(3)
        if not (T0 <= hm < T1): continue
        if m.group(5).startswith("/routefly/api/seen"):   # 화면 js 가 돈 신호(js/seen.js)
            seen.add(hashlib.sha256(salt + m.group(1).split(",")[-1].strip().encode()).hexdigest()[:8]); continue
        st = int(m.group(6))
        if m.group(4) == "GET" and st >= 300 and st != 304:   # 넘김 · 오류 - 경로 묶음과 상태만(그 밖의 주소는 "그 밖" - 남이 만든 글이 요약에 나오지 않게)
            ek = (st, page(m.group(5)) or "그 밖"); errs[ek] += 1
            if kind(m.group(7)) == "검색 로봇": errBot[ek] += 1
            if "googlebot" in (m.group(7) or "").lower(): errG[ek] += 1
        if m.group(4) != "GET" or st >= 400: continue
        pk = page(m.group(5))
        if not pk: continue
        tot += 1; paths[pk] += 1
        slot = "%s:%02d" % (m.group(2), int(m.group(3)) // 15 * 15); q[slot] += 1
        k = kind(m.group(7)); kinds[k] += 1; qk[slot][k] += 1
        h = hashlib.sha256(salt + m.group(1).split(",")[-1].strip().encode()).hexdigest()[:8]
        who[h] += 1; whoKind[h] = k; whoPath[h][pk] += 1; whoUa[h] = safe(m.group(7))
print("범위 %s ~ %s · 화면 합계 %d · 서로 다른 곳 %d" % (T0, T1, tot, len(who)))
print("\n[종류별 곳 수 · 그중 js 가 돈 곳]")
byKind = collections.Counter(whoKind.values())
for k, n in byKind.most_common(): print(" %5d  %5d  %s" % (n, sum(1 for h in who if whoKind[h] == k and h in seen), k))
noJs = collections.Counter(whoUa[h] for h in who if whoKind[h] in ("사람 브라우저", "오래된 크롬(<130)") and h not in seen)
print("\n[js 를 안 낸 사람 쪽 곳의 브라우저 글 상위 10 - 곳 수]"); [print(" %5d  %s" % (n, u)) for u, n in noJs.most_common(10)]
print("\n[브라우저 종류]"); [print(" %6d  %s" % (n, k)) for k, n in kinds.most_common()]
print("\n[경로 묶음 상위 15]"); [print(" %6d  %s" % (n, k)) for k, n in paths.most_common(15)]
print("\n[15분별 - 많은 순 12, 가장 많은 종류]")
for s, n in q.most_common(12): print(" %s %5d  %s" % (s, n, qk[s].most_common(1)[0][0]))
print("\n[넘김 · 오류 응답 - 상태 · 경로 묶음 · 합계 · 검색 로봇 · 구글봇]")
if not errs: print("  없음")
for (s, k), n in sorted(errs.items(), key=lambda x: (-x[1], x[0][0])): print(" %3d  %-14s %6d  %5d  %5d" % (s, k, n, errBot[(s, k)], errG[(s, k)]))
print("\n[많이 연 곳 상위 10 - 주소 대신 해시]")
for h, n in who.most_common(10): print(" %s %5d  %s  %s" % (h, n, whoKind[h], ", ".join("%s %d" % x for x in whoPath[h].most_common(2))))
PY
    ;;
  *) echo "이 열쇠로는 files · tail [N] · log 이름 [N] · grep 낱말 [N] · access 날짜 [부터 까지] 만 됩니다." >&2; exit 2 ;;
esac
