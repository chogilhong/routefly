# routefly 설정 견본
#
# 실제 파일은 저장소 밖에 둡니다(investing 과 같은 방식):
#   C:\GH\config\routefly\config.properties
# 톰캣 실행 인자에 -Droutefly.config=C:\GH\config\routefly\config.properties 를 넣어 읽게 합니다.
# 실제 값(DB 비밀번호, 지도 키)은 이 견본에 적지 마십시오.

# ---------------------------------------------------------------- DB (MariaDB)
# routefly-batch 가 코스를 넣는 DB 입니다. 웹은 읽기만 하므로 SELECT 권한만 있으면 됩니다.
db.url=jdbc:mariadb://127.0.0.1:3306/routefly
db.user=
db.password=
# 연결 풀(2026-10-07). 화면이 연결을 풀에서 빌려 쓰고 돌려줍니다. 비워 두면 기본값.
#   maxActive: 한꺼번에 빌려 줄 수 있는 연결 수 상한(기본 10). 다 쓰고 있으면 돌아올 때까지 기다립니다.
#   maxIdle  : 다 쓰고 돌아온 연결 가운데 닫지 않고 열어 둘 수(기본 5). 보통 maxActive 보다 작게.
#   숫자가 아니거나 1 보다 작으면 기본값을 씁니다.
db.pool.maxActive=10
db.pool.maxIdle=5

# ---------------------------------------------------------------- 지도
# 배경 위성사진: 국토교통부 V-World 인증키(https://www.vworld.kr 에서 무료 발급, 서비스 주소를 등록).
# 비우면 위성사진 없이 지형 음영만 보여 줍니다.
# ※ 이 키는 브라우저로 내려갑니다(지도 타일을 브라우저가 직접 받기 때문). V-World 키는 등록한 주소에서만 동작합니다.
map.vworld.key=

# 3D 지형(고도) 타일. routefly-batch 의 dem.url 과 같은 것을 쓰면 고도 그래프와 지형이 맞습니다.
# 비우면 아래 기본값(AWS Open Data Terrain Tiles, Terrarium 형식).
map.dem.url=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png

# ---------------------------------------------------------------- 숙박 · 날씨(2026-10-14, fly(3D) 안내 버튼)
# 공공데이터포털 일반 인증키(Decoding). 서버에서만 쓰고 브라우저로 내려가지 않습니다. 비우면 숙박 · 날씨 칸에 "준비 중".
#   tour.serviceKey    : 한국관광공사_국문 관광정보 서비스(TourAPI) - 들머리 3km 안 숙박
#   weather.serviceKey : 기상청_단기예보 조회서비스 - 비우면 tour.serviceKey 를 씀(개인 키는 같고 서비스마다 활용 신청만 따로)
#   반려동물 동반 정보는 한국관광공사_반려동물 동반여행 서비스(KorPetTourService2) - 같은 tour.serviceKey, 활용 신청은 따로
#   tour.url · tour.petUrl · tour.petListUrl · weather.url : 주소를 바꿀 때만(기본 KorService2 locationBasedList2 · VilageFcstInfoService_2.0 getVilageFcst)
tour.serviceKey=
weather.serviceKey=

# 기상청 API허브(apihub.kma.go.kr) 인증키(authKey) - 공공데이터포털 키와 다름(API허브 가입 · 활용 신청 따로, 2026-11-14).
# 지금은 확인용 프로그램 web.KmaSeasonProbe(진달래 · 개나리 계절관측 받아 보기)만 씁니다. 화면은 안 씀.
#kma.apihub.key=

# ---------------------------------------------------------------- 공유 링크(2026-10-09 보안)
# 공유 카드 · 넘어갈 주소에 쓰는 이 사이트 주소(예: https://routefly.example.kr/routefly). 비우면 요청의 Host 로 만듭니다
# (X-Forwarded-Host 는 믿지 않음 - 꾸민 머리글로 만든 페이지가 캐시돼 다른 사람이 엉뚱한 곳으로 넘어가는 것을 막으려고).
# 운영 서버에만 넣습니다. PC(개발)는 비워 둡니다 - 넣으면 PC 에서 만든 공유 링크가 서버로 넘어갑니다.
site.baseUrl=

# 들머리 근처 주차장(fly(3D) 가는 길) - 공공데이터포털 「전국주차장정보표준데이터」 CSV 파일 경로(API 아님, 받아서 저장소 밖에 둠).
# UTF-8 · MS949 모두 읽음. 없으면 주차장 줄이 안 보임. 2026-10-14
#parking.csv=C:\\GH\\workspace\\routefly-data\\parking.csv

# ---------------------------------------------------------------- 미세먼지(2026-10-15, 산 소개 페이지 · fly(3D) 날씨)
# 한국환경공단 에어코리아 - 공공데이터포털에서 「대기오염정보」 · 「측정소정보」 두 서비스를 활용 신청.
# 비우면 tour.serviceKey 를 씀(개인 키는 같음). 둘 다 없거나 신청 전이면 미세먼지 줄이 안 보임.
#air.serviceKey=

# ---------------------------------------------------------------- 제휴 · 후원(2026-10-15) - 비우면 화면에 안 보임
# 쿠팡 파트너스: 파트너스 누리집에서 물건마다 만든 링크(https://link.coupang.com/... 또는 https://coupa.ng/...).
#   물건: water(물 · 간식) · rain(우비) · headlamp(헤드랜턴) · battery(보조배터리) · firstaid(구급약 · 밴드) · shoes(등산화)
#        · pack(등산 가방) · stick(등산 스틱) · knee(무릎 보호대) · sun(모자 · 선크림) · warm(보온병 · 핫팩) · crampon(아이젠) · glove(장갑)
#        · recovery(산행 뒤 회복 용품 - 산행을 마친 화면 "다음은?" 에만, 2026-10-28)
#   "이름|주소" 로 적으면 이름마다 단추(recovery 처럼). 예: partner.coupang.recovery=폼롤러|https://link.coupang.com/a/AAA,마사지건|https://link.coupang.com/a/BBB,콘드로이친|https://link.coupang.com/a/CCC
#   산행을 마친 화면 "다음은?"(한국어): recovery 하나 + 그날 것 하나(한겨울 아이젠 → 오르막 800m~ 무릎 보호대 → 11 · 3월 보온 → 6~8월 모자 · 선크림 → 400m~ 스틱 → 무릎 보호대 · 스틱)
#   화면에 보이는 때: 늘 - 물 · 우비 · 헤드랜턴 · 배터리 · 구급약 · 등산화 · 가방 / 오르막 500m~ 스틱, 800m~ 무릎 보호대 /
#                    4~9월 모자 · 선크림, 11~3월 보온병 · 핫팩 · 아이젠, 10~4월 장갑
#   화면은 "🎒 챙길 것" 에 링크와 "쿠팡 파트너스 활동 … 수수료" 문구를 함께 보입니다.
#   한 물건에 여러 개면 쉼표로 이어 씀(3개까지, 화면에 "쿠팡 1 › 쿠팡 2 ›"). 예: partner.coupang.headlamp=https://link.coupang.com/a/AAA,https://link.coupang.com/a/BBB
#partner.coupang.headlamp=
#partner.coupang.stick=
#partner.coupang.crampon=
# 산행을 마친 화면 "다음은?" 의 회복 용품(폼롤러 · 마사지건 · 파스 등, 2026-10-28) - 없으면 그 단추만 안 나옴
#partner.coupang.recovery=폼롤러|,마사지건|,콘드로이친|
# 🎒 추천 상품 상품(그림 + 이름, 2026-11-03 홍TV님 "가민 택틱스 8"): "이름|그림 주소|링크" 한 줄.
#   쿠팡 파트너스에서 그 상품 "이미지 + 텍스트" 링크를 만들면 나오는 코드의 <img src="…"> 가 그림 주소(쿠팡 그림 서버 coupangcdn.com · coupang.com), <a href="…"> 가 링크(link.coupang.com · coupa.ng).
#   한국어 산 페이지 · 코스 모음 · 3D 안내의 "🎒 추천 상품". 셋 중 하나라도 맞지 않으면 안 나옴(서버 로그에 까닭)
#partner.coupang.featured=가민 택틱스 8 세라코트 AMOLED|https://…coupangcdn.com/…|https://link.coupang.com/a/…
#   여러 개(2026-11-03): .2 ~ .10 을 더 적으면 화면을 열 때마다 그 가운데 하나를 무작위로 보임(틀린 줄은 그 줄만 빠짐, 서버 로그에 그 설정 이름과 까닭)
#partner.coupang.featured.2=
#partner.coupang.featured.3=
# 아고다 제휴(승인 뒤): 아고다 파트너 누리집에서 만든 링크(https://www.agoda.com/...). 안의 {lat} · {lon} 은 들머리 좌표로 바뀜.
#partner.agoda.url=
# 트립닷컴 제휴(승인 뒤 - 2026-10-21 신청): 트립닷컴 제휴 누리집에서 만든 숙소 링크(https://kr.trip.com… · www.trip.com… 등 trip.com 주소). {lat} · {lon} 은 들머리 좌표로.
#   한국어 · 영어 화면 모두 "숙소 더 보기" 아래에 아고다와 나란히(둘 다 있으면 둘 다). https 이고 주소 이름이 trip.com(아고다는 agoda.com) 또는 그 아래, 2000자까지, 빈칸 · 따옴표 없이 한 줄(받지 않으면 서버 로그에 까닭)
#partner.trip.url=
# 쏘카 제휴(링크프라이스 경유, 2026-11-03 승인): 링크프라이스 쏘카 머천트 화면의 "대표 링크"(도메인 click.linkprice.com 으로 고른 것)를 그대로.
#   산 페이지(/m/) 코스 목록 아래 "🚗 대중교통이 없는 들머리는 쏘카" 한 줄 - 휴대폰(안드로이드 · 아이폰)에서만 보임(쏘카는 앱 예약만 실적, PC · 모바일 웹은 실적 없음). 주소 이름이 linkprice.com 아래가 아니면 받지 않음
#partner.socar.url=
# Airalo 한국 eSIM(링크프라이스 경유, 2026-11-03 승인): 링크프라이스 Airalo 화면의 딥링크 칸에 https://www.airalo.com/south-korea-esim 을 넣어 만든 링크(click.linkprice.com).
#   영어 산 페이지(/en/m/) 코스 목록 아래 "📶 Korea eSIM" 한 줄 - PC · 휴대폰 모두(실적 PC · 웹 · 앱 모두, 인정기간 30일). 주소 이름이 linkprice.com · airalo.com 아래가 아니면 받지 않음
#partner.airalo.url=
# 나중에 제휴할 숙소 사이트(2026-10-29) - /m/ "🏨 근처 숙소 찾기" 단추. {q} 는 찾는 장소 이름, {lat} · {lon} 은 그 좌표로 바뀜(없으면 링크 그대로 - 그 사이트 검색 화면). 비우면 첫 화면 🔎(제휴 아님)
#   아고다는 위 partner.agoda.url 하나로 - 파트너스 "도구 → 텍스트 링크" 의 링크(https://www.agoda.com/partners/partnersearch.aspx?…)를 그대로 넣어도 됨
#   호텔스컴바인(링크프라이스 경유, 2026-11-03 승인): 링크프라이스 호텔스컴바인 화면의 "대표 링크"(click.linkprice.com)를 그대로 - 첫 화면으로 감.
#   검색 결과로 바로 보내려면 장소 번호(예: 속초 p22032)가 있어야 해 산마다 만들 수 없음(이름 · location= 주소는 첫 화면으로 돌아감 - 2026-11-03 홍TV님 브라우저 확인).
#   PC · 모바일 웹 예약만 실적(앱 ✗), 광고효과 인정기간 0일(누른 그 자리에서 예약해야 실적)
#partner.hotels.url=
# 장소 이름 → 좌표(V-World 검색 API) 키 - 비우면 map.vworld.key 를 씀(V-World 에서 "검색 API" 활용을 함께 신청)
#place.vworld.key=
# 장소 찾기 - 카카오 로컬(키워드) 먼저(들머리 · 관광지 이름을 잘 찾음). 카카오 개발자 앱 → 앱 키 → REST API 키. 서버에서만 씀(화면 · 저장소로 나가지 않음). 비우면 V-World 만
#kakao.restKey=
# 바깥 API 에 새로 묻는 횟수 상한(서버 기억에 없을 때만 셈, 2026-10-30). 비우면 기본값
#   근처 숙소(api/stays - 관광공사 · 카카오): 주소마다 한 시간 40번, 하루 3000번
#   장소 찾기(api/place - 카카오 · V-World): 주소마다 한 시간 30번, 하루 3000번
#quota.stays.ip=40
#quota.stays.day=3000
#quota.place.ip=30
#quota.place.day=3000
#   날씨 칸 행정동(api/wx - 카카오, 2026-11-02): 주소마다 한 시간 60번, 하루 3000번
#quota.region.ip=60
#quota.region.day=3000
# 후원: 토스 아이디(https://toss.me/...) · 카카오페이 송금 코드(https://qr.kakaopay.com/...) 등 https 주소. 안내(about.html) 아래에 단추.
#donate.url=
# 외국 사람용 후원(2026-10-17): PayPal 결제 링크(https://www.paypal.com/ncp/payment/...) · https://paypal.me/... · https://ko-fi.com/...
#   영어 산 페이지(/en/m/) 아래에 "☕ Support routefly" 로 보임. 한국어 페이지는 donate.url 을 씀.
#donate.en.url=

# ---------------------------------------------------------------- 운영 통계(2026-10-15) - /routefly/stats?key=<stats.key>
# 화면 · 산 페이지마다 하루 방문 수 · 방문자 수 · 검색 로봇 수(숫자만, IP 는 남기지 않음). 열쇠는 12자 이상, 비우면 보기 화면이 닫힘(404).
# 열쇠는 영문 대소문자 · 숫자만(2026-10-21 서버: ^ 가 든 열쇠는 톰캣이 주소를 거절해 400). 카톡 · 문자에 올리지 않음(카톡 미리보기 서버가 주소를 가져감).
# 한 번 열면 보기 쿠키(30일 - /stats · /check/heights 둘 다)로 바뀌고 주소에서 열쇠가 빠짐. 틀린 열쇠는 주소마다 10분에 20번까지(넘으면 429, 2026-11-02). 앱은 안내 화면 "안내" 제목 7번 → 열쇠
#stats.key=
# 운영자 기기 쿠키(rf-owner - 통계에서 빠짐 · 방 만들기 한도 없음 · 받은 코스 점검)에 섞는 값(2026-11-02, 비워도 됨 - 비우면 예전 그대로).
# 바꾸면 운영자 기기가 모두 로그아웃됩니다 - 기기가 털렸거나 쿠키가 샜을 때 바꾸고 톰캣 재시작, 쓸 기기에서 /stats 를 다시 열면 새 쿠키를 받음(docs/deploy-lightsail.md)
#stats.ownerSalt=
# 통계 파일 폴더(비우면 톰캣 폴더/routefly-stats)
#stats.dir=

# 🧰 별거 별거(2026-10-18)
#   공휴일: 한국천문연구원_특일 정보(SpcdeInfoService) - 비우면 tour.serviceKey 를 씀(같은 개인 키, 공공데이터포털에서 활용 신청만 따로).
#           신청 전이거나 키가 없으면 별거 별거의 공휴일 칸에 "받을 수 없음" 이 보임.
#holiday.serviceKey=
#   물때: 해양수산부 국립해양조사원_조석예보(고, 저조)(공공데이터포털 15156018) - 비우면 tour.serviceKey(같은 키, 활용 신청만 따로).
#tide.serviceKey=
#   🛟 오늘의 산행 안전(api/safety): 기상청 기상특보 · 생활기상지수(4.0) · 산림청 산불위험예보 · 국립중앙의료원 응급의료기관 - 비우면 tour.serviceKey(같은 키, 서비스마다 활용 신청).
#safety.serviceKey=
#   기름값: 한국석유공사 오피넷 무료 API(opinet.co.kr 에서 따로 받는 키). 없으면 기름값 칸에 "받을 수 없음".
#opinet.key=
#   holiday.url · tide.url · opinet.url : 주소를 바꿀 때만(기본 SpcdeInfoService getRestDeInfo · tideFcstHghLw GetTideFcstHghLwApiService · https://www.opinet.co.kr/api/)

# ---------------------------------------------------------------- 산악회 방(2026-10-20) - party.html · /api/party
# 인솔자에게 회원 위치를 보여 주는 기능이라 위치기반서비스사업 신고를 마친 뒤에만 true. 그 전에는 비우거나 false(화면은 "준비 중").
# PC(개발)에서 시험할 때만 true 로 켜 봄.
#party.enabled=false
#   위치기반서비스 이용약관(lbs-terms.html)의 사업자 정보(위치정보법 12조 - 상호 · 주소 · 전화, 2026-10-26). 저장소에는 적지 않음.
#biz.name=
#biz.address=
#biz.phone=
#   안드로이드 앱을 스토어에 올린 뒤 true(2026-10-24 홍TV님, 2026-11-10 원스토어 출시). 그 전에는 비움 - 산악회 방 회원을 크롬으로, true 면 앱으로(없으면 원스토어 설치 화면 - party.js STORE_URL).
#app.released=false

# ---------------------------------------------------------------- 의견 보내기(2026-10-20) - feedback.html · /api/feedback
# 손님 글을 이 메일로 보냄(SMTPS 465). 넷 중 하나라도 비면 메일 없이 파일(stats.dir/feedback/)에만 남음.
# Gmail: Google 계정 → 보안 → 2단계 인증 켜기 → "앱 비밀번호" 만들기(16자). 계정 비밀번호가 아니라 그 앱 비밀번호를 넣음.
#mail.smtp.host=smtp.gmail.com
#mail.smtp.port=465
#mail.smtp.user=
#mail.smtp.password=
#mail.to=
# 의견 파일 폴더(비우면 stats.dir 아래 feedback). 예: PC 는 feedback.dir=E:\\GH\\feedback (윈도 경로는 \\ 두 개 또는 / 로)
#feedback.dir=

# ---------------------------------------------------------------- 안드로이드 앱 링크(2026-10-20) - /.well-known/assetlinks.json
# 산악회 방 참가 링크를 routefly 앱이 바로 열게. 앱 서명 키의 SHA-256 지문(공개 값, AB:CD:… 꼴). 쉼표로 여럿:
#   시험판(debug.keystore) · 스토어 업로드 키 · Play Console > 앱 무결성 > 앱 서명 키. 비우면 그 주소는 404(앱 링크는 고르는 창으로).
#app.sha256=

# 구글 애드센스(2026-10-28) - 산 페이지(/m/) · 코스 소개 페이지(/c/)에만 광고 칸. 비우면 광고 없음. 값은 운영 서버에만(저장소 · 대화에 적지 않음)
#adsense.client=ca-pub-…
#adsense.slot.m=…
#adsense.slot.c=…
# 도구(tools.html) 맨 아래 · 도장(series.html) 목록 아래 칸(2026-11-01) - 비우면 산 페이지 칸(adsense.slot.m)을 같이 씀
#adsense.slot.tools=…
#adsense.slot.series=…

# 내 기록 → 코스로 올리기(관리자 기기만, 2026-10-31) - 올린 GPX 를 둘 폴더. 비우면 /opt/routefly/course-inbox(없으면 올리기가 "폴더 없음" 으로 멈춤).
# 서버 만들기: sudo install -d -o tomcat -g routefly -m 2750 /opt/routefly/course-inbox (routefly-batch courseImport 가 같은 폴더를 읽음)
course.inboxDir=
# 올린 코스의 만든 이(2026-11-01 - 코스 화면 "만든 이: …" 한 줄)는 설정 없이 party.json 과 같은 폴더(party.dir → stats.dir → 톰캣 폴더/routefly-party)의
# course-makers.json(600)에 남음 - 처음 올릴 때 저절로 생김. 나중에 제휴 산악회는 그 코스 칸에 "partner": true 를 더하면 "[제휴]"(결제는 아직 없음)

# 코스 보내기(2026-11-01) - 등산객이 보낸 GPX(점만 다시 씀) · 정보(.json)를 둘 폴더. 비우면 /opt/routefly/course-submit(없으면 보내기가 "지금은 받을 수 없음" 으로 멈춤).
# 톰캣만 읽고 씀(GPX 편집 화면 📨 받은 GPX 가 점검 · 올리기 · 버리기, 30일 지나면 저절로 지움): sudo install -d -o tomcat -g tomcat -m 0750 /opt/routefly/course-submit
course.submitDir=
