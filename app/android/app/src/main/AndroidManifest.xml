<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 앱 링크(2026-10-20 홍TV님): 카톡 · 문자 · QR · NFC 의 산악회 방 참가 링크를 앱이 깔린 폰에서는 앱으로 엶(MainActivity.openLink).
                 autoVerify - 서버 https://routefly.kr/.well-known/assetlinks.json 에 이 앱의 서명 지문이 있어야 "항상 앱으로"(없으면 고르는 창) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="routefly.kr" android:pathPrefix="/routefly/party.html" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 2026-10-17: 웹뷰 navigator.vibrate(움직임 없음 · 일몰 · 갈림길 알림)는 이 권한이 없으면 말없이 무시됨 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 2026-10-21: 산악회 방 "폰은 켜짐"(RfAlivePlugin) - 화면이 꺼진 동안 1분마다 보내려고 CPU 를 깨워 둠(방에 있는 동안만, 최대 14시간) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 2026-10-27: 인솔자가 NFC 스티커에 참가 링크 쓰기(RfNfcPlugin). NFC 가 없는 폰에도 깔리게 required=false -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
</manifest>
